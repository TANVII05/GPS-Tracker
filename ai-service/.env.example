# ==========================================
# NCH GPS Tracker AI Backend Configuration
# ==========================================

# 1. OpenAI API Credentials
OPENAI_API_KEY=your_openai_api_key_here

# 2. Configurable LLM Models (For Feature 3 Cost/Latency comparison)
MODEL_PRIMARY=gpt-4o-mini
MODEL_SECONDARY=gpt-4o

# 3. Anomaly Detection Domain Thresholds (km/h)
NORMAL_SPEED_MAX_KMH=60.0
IMPOSSIBLE_SPEED_MIN_KMH=150.0
MAX_STATIONARY_DWELL_MINS=45.0

# 4. Google Sheets API Settings
# Path to your Google Cloud Service Account JSON key file
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json
# Your Google Spreadsheet ID (from the Google Sheet URL)
GOOGLE_SHEET_ID=your_google_sheet_id_here
GOOGLE_SHEET_NAME=All Trips

# 5. Local Development Mock Mode
# If true, uses an in-memory mock Google Sheet when credentials are not found
ENABLE_MOCK_SHEETS_IF_NO_CREDS=true
